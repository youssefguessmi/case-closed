# MySQL server
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Admin account - ONLY used by `python -m pipeline.load` to create schemas/users and load data
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Accounts created by the loader. The chatbot only ever uses these.
MYSQL_RO_USER=investigator_ro
MYSQL_RO_PASSWORD=change-me-ro
MYSQL_AUDIT_USER=audit_writer
MYSQL_AUDIT_PASSWORD=change-me-audit

# Gemma: "ollama" (local, default) or "google" (Google AI Studio, needs `pip install google-genai`)
LLM_BACKEND=ollama
OLLAMA_MODEL=gemma3:4b
# GOOGLE_MODEL=gemma-3-27b-it
# GOOGLE_API_KEY=

MAX_ROWS=500
QUERY_TIMEOUT_MS=5000
MAX_SQL_RETRIES=2
